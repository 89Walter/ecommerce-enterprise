{
  "realm": "ecommerce",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Customer account"
      },
      {
        "name": "ADMIN",
        "description": "Catalog management access"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "catalog-audience",
      "description": "Adds the catalog service as an access-token audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "catalog-service audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "catalog-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "catalog-postman",
      "name": "Catalog API local Postman client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "roles",
        "catalog-audience",
        "profile",
        "email"
      ]
    }
  ]
}
