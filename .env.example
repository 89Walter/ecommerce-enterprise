# Copia questo file in .env e sostituisci tutte le password.
# Valori solo per sviluppo locale: non riutilizzarli in produzione.

# --- MySQL (un server, un database e un utente per servizio) ---
MYSQL_ROOT_PASSWORD=change-me-root
CATALOG_DB_PASSWORD=change-me-catalog
ORDER_DB_PASSWORD=change-me-order
USER_DB_PASSWORD=change-me-user
PAYMENT_DB_PASSWORD=change-me-payment
SHIPPING_DB_PASSWORD=change-me-shipping

# --- Redis (cache del catalog) ---
REDIS_PASSWORD=change-me-redis

# --- RabbitMQ (eventi asincroni) ---
# Amministratore: console di management e creazione degli utenti dei servizi.
RABBITMQ_USERNAME=ecommerce
RABBITMQ_PASSWORD=change-me-rabbit
# Un utente per servizio (order-service, payment-service, shipping-service), creato da infra/rabbitmq/setup-service-users.sh:
# ognuno può pubblicare solo i propri eventi (routing key order.*, payment.*, shipping.*).
ORDER_RABBITMQ_PASSWORD=change-me-rabbit-order
PAYMENT_RABBITMQ_PASSWORD=change-me-rabbit-payment
SHIPPING_RABBITMQ_PASSWORD=change-me-rabbit-shipping

# --- Gateway ---
# Rate limiting per utente (o per IP se anonimo): richieste al secondo e picco massimo.
GATEWAY_RATE_LIMIT_PER_SECOND=10
GATEWAY_RATE_LIMIT_BURST=20
# Swagger UI e /v3/api-docs dei microservizi: metti false in produzione.
API_DOCS_ENABLED=true

# --- Keycloak ---
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# --- Porte esposte su 127.0.0.1 (cambiale se sono già occupate) ---
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
KEYCLOAK_HOST_PORT=9000
GATEWAY_HOST_PORT=8080
# Frontend in Docker: deve restare tra le origini CORS qui sotto e i redirect URI di Keycloak (3000 o 5173).
FRONTEND_HOST_PORT=3000

# --- Frontend ammessi dal gateway (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Utenti di sviluppo in Keycloak (creati da infra/keycloak/create-dev-users.sh) ---
# Se lasci vuote le password, lo script le genera e le scrive qui.
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=
DEV_CUSTOMER_USERNAME=cliente
DEV_CUSTOMER_PASSWORD=
