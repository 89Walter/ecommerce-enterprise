<?xml version="1.0" encoding="UTF-8"?>
<!--
    Aggregatore: permette di compilare e testare tutti i microservizi con un solo comando
    (mvn test dalla root). Non è un parent: ogni servizio resta indipendente e ha il proprio pom.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ecommerce</groupId>
    <artifactId>ecommerce</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ecommerce</name>
    <description>E-commerce a microservizi</description>

    <modules>
        <module>catalog-service</module>
        <module>order-service</module>
        <module>user-service</module>
        <module>payment-service</module>
        <module>shipping-service</module>
        <module>gateway-service</module>
    </modules>
</project>
